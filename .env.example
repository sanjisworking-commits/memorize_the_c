APP_ENV=development
APP_BASE_URL=http://127.0.0.1:8010
PORT=8010

# Enable the multi-user auth gate and per-user progress.
MULTIUSER_ENABLED=true

# V1 production defaults: keep Memory Log / Relevant Laws off.
# MEMORY_LOG_ENABLED=true is not supported with PostgreSQL yet.
MEMORY_LOG_ENABLED=false
RELEVANT_LAWS_ENABLED=false

# 3-Free-Article entitlement boundary (claim prompts, Type/Recite locks,
# cap gate, access-status surfaces). Keep false until steps 1-4 are verified;
# requires `alembic upgrade head` (user_free_articles) on Postgres.
ARTICLE_ENTITLEMENTS_ENABLED=false

# /pricing page. Keep false publicly until a purchase flow exists.
PRICING_ENABLED=false

DATABASE_URL=postgresql://user:password@localhost:5432/recall_the_c_multiuser

SUPABASE_URL=
SUPABASE_ANON_KEY=

SESSION_SECRET=

AUTH_GOOGLE_ENABLED=true
AUTH_PHONE_ENABLED=true

COOKIE_SECURE=false

# Optional CAPTCHA integration point for staging/production OTP sends.
CAPTCHA_ENABLED=false
CAPTCHA_SECRET=

# Optional Resend admin email for issue reports (all three required to enable).
RESEND_API_KEY=
REPORT_EMAIL_FROM=
REPORT_EMAIL_TO=

# Optional Cloudflare Turnstile for POST /api/report-issue (server-side).
# When enabled, both site key and secret key are required.
REPORT_TURNSTILE_ENABLED=false
REPORT_TURNSTILE_SITE_KEY=
REPORT_TURNSTILE_SECRET_KEY=
